{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "types": ["node"],
    "paths": {
      "#chaincraft/*.js": ["./src/*.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
